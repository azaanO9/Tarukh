# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/dist-pages/
/dist-vercel/
/.vercel/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/
/.sites-deploy/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# Authoring/review models stay local; include only the prepared game assets.
/assets/outpost-review/**/*.glb
/assets/outpost-review/**/*.blend
/public/models/outpost/*.glb
/public/models/greenhouse/*.glb
/public/models/garage/*.glb
!/public/models/outpost/campus.glb
!/public/models/greenhouse/cultivation.glb
!/public/models/garage/garage.glb

# OS metadata
.DS_Store

# Local credentials, caches, and handoff archives
*.key
*.p12
*.pfx
*.log
*.zip
Thumbs.db
